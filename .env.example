# Admin email authentication (add as encrypted Worker secrets/variables in Cloudflare)
OWNER_EMAIL=owner@example.com
# Store a long random value (at least 32 characters) as a Worker Secret. Never commit the real value.
ADMIN_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Add RESEND_API_KEY as an encrypted Worker Secret. Never put its real value in this file.

# D1 is provided through the Cloudflare Worker binding named DB.
